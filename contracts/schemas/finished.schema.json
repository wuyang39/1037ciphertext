{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1-22 Finished",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "session_id",
    "transcript_hash",
    "verify_data",
    "signature"
  ],
  "properties": {
    "protocol_version": {
      "const": "a122-gm-session-v1"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transcript_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verify_data": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
