# A1-22 Gramine manifest template, written for the Gramine 1.9 manifest schema.
#
# The build process substitutes {{ ... }} values from a signed release
# manifest. Production refuses this file when sgx.debug is true.
#
# Two schema details are easy to get wrong and were confirmed against Gramine
# 1.9 on the D1 instance: the LibOS entrypoint is ``libos.entrypoint``
# (``loader.entrypoint`` is a TOML table holding the signed libsys), and the
# extra-file allowlist is ``sgx.allowed_files`` rather than ``fs.allowed_files``.

libos.entrypoint = "{{ entrypoint }}"
loader.insecure__use_cmdline_argv = false
loader.env.LD_LIBRARY_PATH = "/lib:/usr/lib:/usr/local/lib"
loader.env.A1_22_RELEASE_ID = "{{ release_id }}"
loader.env.A1_22_ROLE = "{{ role }}"
loader.env.A1_22_SHARE_EPOCH = "{{ share_epoch }}"

sgx.debug = false
sgx.enclave_size = "{{ enclave_size }}"
sgx.max_threads = 32
sgx.remote_attestation = "dcap"

sys.stack.size = "8M"
sys.enable_sigterm_injection = true

fs.mounts = [
  { path = "/lib", uri = "file:{{ lib_dir }}" },
  { path = "/usr/lib", uri = "file:{{ lib_dir }}" },
  { path = "/usr/local/lib", uri = "file:{{ lib_dir }}" },
  { type = "tmpfs", path = "/run/tee" },
  { type = "tmpfs", path = "/run/session" },
  { type = "encrypted", path = "/secure", uri = "file:{{ secure_fs_dir }}", key_name = "{{ key_name }}" },
]

sgx.allowed_files = [
  "{{ python_runtime_path }}",
]

sgx.trusted_files = [
  "file:{{ entrypoint }}",
  "file:{{ python_runtime_path }}",
  "file:{{ lib_dir }}",
]
