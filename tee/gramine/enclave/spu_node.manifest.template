# A1-22 D4 enclave node manifest (gramine-sgx).
#
# @PLACEHOLDERS@ are substituted by deploy/run_d4_gramine.sh; the Jinja values
# come from gramine-manifest. Compared with the D3 Worker manifest this one
# drops the encrypted FS and adds what the SPU node needs: the venv that
# carries SecretFlow-SPU 0.9.5 (libspu.so alone is 288 MB of BRPC/YACL/XLA),
# the D4 workspace it reads its role config and PKI material from, and a
# writable out/ directory for the status files the collector picks up.
#
# Every mount keeps the host path, so the absolute paths the node configs and
# the runner already carry stay valid inside the enclave.

libos.entrypoint = "@PYTHON@"

loader.log_level = "warning"
# @ARCH_LIBDIR@ and @USR_LIBDIR@ stay separate so the rendered paths never
# collapse into a "/usr//lib/..." that Gramine treats as unmounted.
loader.env.LD_LIBRARY_PATH = "/lib:@ARCH_LIBDIR@:@USR_LIBDIR@"
loader.env.PYTHONPATH = "@REPO@:@SITE@"
loader.env.PYTHONDONTWRITEBYTECODE = "1"
# The node loads libspu.so through this path rather than importing the spu
# package, which keeps JAX out of the enclave.
loader.env.A122_LIBSPU_PATH = "@LIBSPU@"
loader.insecure__use_cmdline_argv = true

sys.stack.size = "@STACK_SIZE@"

sgx.debug = false
sgx.enclave_size = "@ENCLAVE_SIZE@"
sgx.max_threads = @MAX_THREADS@
sgx.remote_attestation = "dcap"

fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "@ARCH_LIBDIR@", uri = "file:@ARCH_LIBDIR@" },
  { path = "@USR_LIBDIR@", uri = "file:@USR_LIBDIR@" },
  { path = "@UV_ROOT@", uri = "file:@UV_ROOT@" },
  { path = "@SITE@", uri = "file:@SITE@" },
  { path = "@REPO@", uri = "file:@REPO@" },
  { path = "@WORKSPACE@", uri = "file:@WORKSPACE@" },
  { type = "tmpfs", path = "/tmp" },
]

sgx.trusted_files = [
  "file:@PYTHON@",
  "file:{{ gramine.runtimedir() }}/",
  "file:@ARCH_LIBDIR@/",
  "file:@USR_LIBDIR@/",
  "file:@UV_ROOT@/",
  "file:@SITE@/",
  "file:@LIBSPU@",
  "file:@REPO@/",
  "file:@WORKSPACE@/",
]

sgx.allowed_files = [
  "file:/lib64/ld-linux-x86-64.so.2",
  "file:@ARCH_LIBDIR@/ld-linux-x86-64.so.2",
  # The workspace is trusted above, so only the out/ subtree is opened for
  # writing: the role status, the vector results and the communication trace
  # land there and the collector reads them back on the host.
  "file:@WORKSPACE@/out/",
]
